<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- usesCleartextTraffic: required for the documented LAN accommodation (spec section 4,
         privacy policy "Data in transit"); without it the platform blocks plain http outright
         on Android 9+ and the feature is dead at the socket. This attribute is NOT the policy.
         The app-level gates are: ServerUrlNormaliser rejects http for any non-private host, and
         Onboarding refuses to even start a Login Flow over http until the user has read and
         confirmed an explicit everything-travels-unencrypted warning (Status.CONFIRM_HTTP). The
         Login Flow poll response's server URL is re-validated through the same normaliser, so a
         server cannot silently downgrade an https sign-in to a stored http endpoint. A
         networkSecurityConfig cannot replace this: NSC domain rules cannot express "any
         RFC1918/private address", which is exactly the set the normaliser admits. -->
    <application
        android:name=".BudgetApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.BudgetReceipts"
        android:usesCleartextTraffic="true"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <!-- singleTop: the review notification targets this same Activity. Under the default
             "standard" mode a tap creates a *second* MainActivity instance (a second Compose
             tree, a second camera binding) instead of delivering onNewIntent to the running
             one, so the warm-start handling in MainActivity.onNewIntent almost never ran. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Disable WorkManager's default (non-Hilt) initialiser: without this,
             androidx.startup constructs WorkManager before Application.onCreate runs,
             using the default WorkerFactory instead of HiltWorkerFactory, so every
             @HiltWorker fails to construct at runtime. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
