    <!-- Welcome -->
    <string name="welcome_title">Welcome to Budget Companion</string>
    <string name="welcome_subtitle">Capture receipts and save them straight to Budget on your Nextcloud.</string>
    <string name="welcome_step1_title">Snap a receipt</string>
    <string name="welcome_step1_body">Photograph it with the camera, or share an image from another app.</string>
    <string name="welcome_step2_title">Your server reads it</string>
    <string name="welcome_step2_body">If receipt scanning is set up on your Budget server, it reads the merchant, date, total and individual items for you automatically.</string>
    <string name="welcome_step3_title">Review and save</string>
    <string name="welcome_step3_body">Check the details — split them across categories if you like — and save. Captured offline? It\'s queued and sent the moment you\'re back online.</string>
