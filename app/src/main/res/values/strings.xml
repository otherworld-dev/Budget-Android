    <string name="onboarding_connect">Connect</string>
    <string name="onboarding_waiting_browser">Waiting for your browser…</string>
    <string name="onboarding_http_title">Connect without encryption?</string>
    <string name="onboarding_http_body">This address uses plain http, so nothing sent to it is encrypted: your password, your receipts, and every amount travel readable by anyone on the same network. Only continue on a private network you trust. If your server supports https, use that instead.</string>
    <string name="onboarding_connect_anyway">Connect anyway</string>

    <!-- Welcome -->
    <string name="welcome_title">Welcome to Budget Companion</string>
    <string name="welcome_subtitle">Capture receipts and save them straight to Budget on your Nextcloud, and keep an eye on where you stand.</string>
    <string name="welcome_step1_title">Snap a receipt</string>
    <string name="welcome_step1_body">Photograph it with the camera, or share an image from another app.</string>
    <string name="welcome_step2_title">Your server reads it</string>
    <string name="welcome_step2_body">If receipt scanning is set up on your Budget server, it reads the merchant, date, total and individual items for you automatically.</string>
    <string name="welcome_step3_title">Review and save</string>
    <string name="welcome_step3_body">Check the details — split them across categories if you like — and save. Captured offline? It\'s queued and sent the moment you\'re back online.</string>
    <string name="welcome_step4_title">Check where you stand</string>
    <string name="welcome_step4_body">Overview shows your account balances, how much of this month\'s budget is left and any bills due in the next two weeks. Activity lists your recent transactions, with splits and transfers shown as well. Setting things up and making changes is still done in Budget on the web.</string>
    <string name="welcome_ocr_notice">Receipt scanning is a feature of your Budget server — you\'ll find it in Budget\'s settings in Nextcloud. Without it, you can still capture receipts and enter the details yourself.</string>
    <string name="welcome_get_started">Get started</string>

