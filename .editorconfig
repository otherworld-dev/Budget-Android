# EditorConfig — https://editorconfig.org
# Codifies the conventions already used across this repo so editors and any future
# ktlint/detekt pass agree on them. Purely advisory to editors; changes no build output.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.{kt,kts}]
# Kotlin official code style, as this project already follows.
ktlint_code_style = intellij_idea
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# The codebase uses explicit imports throughout; keep it that way.
ij_kotlin_name_count_to_use_star_import = 2147483647
ij_kotlin_name_count_to_use_star_import_for_members = 2147483647

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[gradlew.bat]
end_of_line = crlf
